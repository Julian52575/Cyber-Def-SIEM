#!/usr/bin/env bash
# Git runs the hook only under this exact filename. The checks live in their
# own scripts so each reads as a pair with its CI / ruleset counterpart.
# check-just is last: it is the slow one, so it only runs once the rest pass.
dir="$(dirname "$0")"
"$dir/check-conventional-commit-msg" "$@" && "$dir/check-signature" "$@" && "$dir/check-just"
