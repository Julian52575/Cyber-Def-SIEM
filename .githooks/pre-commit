#!/usr/bin/env bash
# Git runs the hook only under this exact filename. `just check` runs from
# commit-msg instead, after the cheap checks, so a rejected message does not
# cost a full check run.
dir="$(dirname "$0")"
# Concluding a merge with `git commit` (after a conflict or --no-commit) skips
# pre-merge-commit.
if git rev-parse -q --verify MERGE_HEAD >/dev/null; then
  exec "$dir/pre-merge-commit"
fi
